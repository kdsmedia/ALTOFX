<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- BAB 10: izin rekam audio untuk input mikrofon / audio interface. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Dukungan USB host untuk USB Audio Interface (mis. iRig). -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <!-- Mikrofon dan jalur audio low-latency; opsional agar tetap bisa dipasang
         di perangkat tanpa fitur tersebut. -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.audio.low_latency"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.audio.pro"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AltoGuitarFX">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AltoGuitarFX">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
